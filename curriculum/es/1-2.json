  {
   "id": "es.1.2.4",
   "title": "冠词",
   "words": [
    "el",
    "la",
    "los",
    "las",
    "un",
    "una",
    "cosa",
    "país",
    "calle"
   ],
   "grammar": [
    {
     "ref": "articulos"
    },
    {
     "title": "定冠词与不定冠词",
     "points": [
      "定冠词（这个/那个）：el（阳单）la（阴单）los（阳复）las（阴复）。",
      "不定冠词（一个/一些）：un（阳）una（阴）unos unas（一些）。",
      "缩合：a + el → al（Voy al cine）；de + el → del（Es del profesor）。",
      "以重读 a 开头的阴性单数名词用 el：el agua, el aula（但仍是阴性：el agua fría）。",
      "说星期几前用定冠词表示“在”：el lunes（在周一），los lunes（每周一）。"
     ],
     "examples": [
      [
       "Voy al parque con el perro del vecino.",
       "我带着邻居的狗去公园。"
      ]
     ]
    }
   ],
   "special": [
