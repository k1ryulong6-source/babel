  {
   "id": "es.1.2.2",
   "title": "主语代词与 ser",
   "words": [
    "yo",
    "tú",
    "él",
    "ella",
    "usted",
    "nosotros",
    "ellos",
    "español",
    "chino",
    "japonés"
   ],
   "grammar": [
    {
     "title": "ser：是",
     "points": [
      "主语代词：yo 我、tú 你、él 他、ella 她、usted 您、nosotros/as 我们、vosotros/as 你们（西班牙）、ellos/ellas 他们、ustedes 您们（拉美也作“你们”）。",
      "ser 现在时：soy, eres, es, somos, sois, son。",
      "ser 表示身份、职业、国籍、来源：Soy estudiante. Es japonesa. Somos de China.（职业前不加冠词）",
      "动词变位已经表明人称，主语代词常省略：Soy chino.（= Yo soy chino.）",
      "国籍形容词有阴阳性：chino / china, japonés / japonesa, español / española。"
     ],
     "examples": [
      [
       "Soy de China, pero vivo en Japón.",
       "我来自中国，但住在日本。"
      ]
     ]
    }
   ],
   "special": [
