       ],
       "a": 1
      },
      {
       "t": "f",
       "q": "Nosotros ___ a comprar un regalo.",
       "a": [
        "vamos"
       ]
      },
      {
       "t": "tr",
       "zh": "这个周末你打算做什么？",
       "a": [
        "¿Qué vas a hacer este fin de semana?"
       ]
      }
     ]
    },
