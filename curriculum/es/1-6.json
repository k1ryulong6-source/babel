   "grammar": [
    {
     "ref": "gustar"
    },
    {
     "title": "“某物让我喜欢”",
     "points": [
      "gustar 的结构和中文相反：<b>喜欢的东西是主语</b>：Me gusta el café.（单数）Me gustan las frutas.（复数）",
      "间接宾语代词：me, te, le, nos, os, les。A mí me gusta… / A ella le gusta…（a + 人 用来强调或说明）。",
      "后接动词原形用单数：Me gusta leer.",
      "名词前要加定冠词：Me gusta <b>el</b> chocolate（不说 Me gusta chocolate）。",
      "同类动词：encantar（非常喜欢）、interesar、doler。"
     ],
     "examples": [
      [
       "Me gusta mucho el pescado, pero no me gustan las verduras.",
       "我很喜欢鱼，但不喜欢蔬菜。"
      ]
     ]
    }
   ],
   "special": [
