   "grammar": [
    {
     "ref": "b_clause"
    },
    {
     "title": "用一个句子修饰名词",
     "points": [
      "who 修饰人：The man who lives next door is a doctor.",
      "which 修饰物：The bag which I bought yesterday is red.",
      "that 人和物都可以（口语最常用）：the book that I read。",
      "关系词在从句里作宾语时可以省略：The movie (that) we saw was great.",
      "whose 表示“……的”：the girl whose father is a pilot。",
      "中文把修饰语放在名词前（“住在隔壁的男人”），英语放在名词后。"
     ],
     "examples": [
      [
       "The restaurant that we went to last night was excellent.",
       "我们昨晚去的那家餐厅非常好。"
      ]
     ]
    }
   ],
