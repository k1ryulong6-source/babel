   "grammar": [
    {
     "ref": "b_passive"
    },
    {
     "title": "“被……”：be + 过去分词",
     "points": [
      "主动：People speak English here. → 被动：English is spoken here.",
      "be 随时态变：is made（现在）、was made（过去）、will be made（将来）、has been made（完成）、can be made（情态）。",
      "什么时候用被动：不知道/不重要是谁做的；想强调承受动作的人或物。商务英语（托业）里非常多：The meeting was postponed.",
      "动作执行者用 by：The book was written by a doctor."
     ],
     "examples": [
      [
       "This bridge was built in 1990.",
       "这座桥建于 1990 年。"
      ]
     ]
    }
   ],
   "special": [
