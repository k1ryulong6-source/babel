   "grammar": [
    {
     "title": "I think … / Do you know …?",
     "points": [
      "宾语从句：I think (that) he is right. I know (that) she lives here.（that 常省略）",
      "“是否”用 if / whether：I don't know if he will come.",
      "间接疑问用<b>陈述语序</b>：Do you know where the station is?（不是 where is the station）",
      "更礼貌的问法：Could you tell me what time it is? / I wonder why she left.",
      "否定前移：I don't think it will rain.（比 I think it won't rain 更自然）"
     ],
     "examples": [
      [
       "Could you tell me where the nearest bank is?",
       "能告诉我最近的银行在哪吗？"
      ]
     ]
    }
   ],
