   "grammar": [
    {
     "ref": "b_nonfinite"
    },
    {
     "title": "动词后面跟哪一种",
     "points": [
      "接 to do：want, hope, decide, plan, need, agree, promise, refuse, learn, try（努力）",
      "接 doing：enjoy, finish, mind, avoid, practice, keep, suggest, give up",
      "两者意思不同：stop to do（停下来去做另一件事）/ stop doing（停止正在做的事）；remember to do（记得要去做）/ remember doing（记得做过）。",
      "介词后面用 doing：I'm good at cooking. Thank you for coming.",
      "表目的用 to do：I came here to study."
     ],
     "examples": [
      [
       "I enjoy reading, and I want to read more this year.",
       "我喜欢读书，今年想多读一些。"
      ]
     ]
    }
   ],
