   "grammar": [
    {
     "ref": "b_conj"
    },
    {
     "title": "把句子连起来",
     "points": [
      "and 并列，but 转折，or 选择，so 结果，because 原因。",
      "because 和 so 不能同时用：Because it rained, so we stayed home. ✗",
      "although 和 but 不能同时用：Although it was late, but... ✗",
      "when 当……时，if 如果，before / after 在……之前/之后，until 直到。",
      "both A and B 两者都；either A or B 要么……要么；neither A nor B 两者都不；not only A but also B 不但……而且。"
     ],
     "examples": [
      [
       "I was tired, so I went to bed early.",
       "我很累，所以早早睡了。"
      ]
     ]
    }
   ],
   "special": [
    {
     "w": "because of",
     "t": "介词短语",
     "s": [
      [
       "",
       "因为（后接名词）"
      ]
     ],
     "x": [
      [
       "The game stopped because of the rain.",
       "比赛因雨暂停。"
      ]
     ]
    },
