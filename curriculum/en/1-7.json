   "grammar": [
    {
     "ref": "b_prep"
    },
    {
     "title": "in / on / at",
     "points": [
      "时间：at + 钟点、时刻（at 7, at noon, at night）；on + 某一天（on Monday, on May 5th）；in + 月、年、季节、上下午（in July, in 2025, in the morning）。",
      "地点：at + 点（at the station, at home）；on + 面（on the table, on the wall）；in + 空间内（in the box, in Tokyo）。",
      "交通：in a car / taxi；on a bus / train / plane。",
      "其他常用：under, behind, between A and B, across from, around, during, until, by（不迟于）。"
     ],
     "examples": [
      [
       "The meeting is at 3 p.m. on Friday in Room 5.",
       "会议周五下午三点在五号房间。"
      ]
     ]
    }
