   ],
   "grammar": [
    {
     "title": "指示代词与名词所有格",
     "points": [
      "this / these 指近处，that / those 指远处：this book, these books, that car, those cars。",
      "打电话介绍自己用 this：Hello, this is Mike.",
      "名词所有格：单数加 's（Tom's car），以 s 结尾的复数只加 '（my parents' house），不以 s 结尾的复数加 's（children's books）。",
      "物的所有关系多用 of：the name of the street, the end of the movie。"
     ],
     "examples": [
      [
       "These are my sister's shoes.",
       "这些是我姐姐的鞋。"
      ]
     ]
    }
   ],
