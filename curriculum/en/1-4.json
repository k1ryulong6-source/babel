   "grammar": [
    {
     "ref": "b_noun"
    },
    {
     "title": "复数的变法",
     "points": [
      "一般加 -s：book → books；以 s, x, sh, ch 结尾加 -es：bus → buses, box → boxes, watch → watches",
      "辅音 + y → 变 y 为 i 加 -es：city → cities, family → families（元音 + y 直接加 s：day → days）",
      "以 f/fe 结尾多变 -ves：knife → knives, life → lives, leaf → leaves",
      "不规则：man → men, woman → women, child → children, foot → feet, tooth → teeth, person → people",
      "单复同形：sheep, fish, Japanese, Chinese"
     ],
     "examples": [
      [
       "Three children and two women are in the room.",
       "房间里有三个孩子和两个女人。"
      ]
     ]
    }
   ],
   "special": [
