    {
     "title": "一张表",
     "points": [
      "主格（作主语）：I you he she it we they",
      "宾格（作宾语、介词后）：me you him her it us them",
      "形容词性物主代词（后面接名词）：my your his her its our their",
      "名词性物主代词（单独用）：mine yours his hers its ours theirs",
      "反身代词：myself yourself himself herself itself ourselves themselves",
      "it's = it is；its = 它的。"
     ],
     "examples": [
      [
       "This is my bag. That one is yours.",
       "这是我的包，那个是你的。"
      ]
     ]
    }
