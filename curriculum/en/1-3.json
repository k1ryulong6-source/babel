   "grammar": [
    {
     "ref": "b_be"
    },
    {
     "title": "am / is / are 怎么选",
     "points": [
      "I → am；he / she / it / 单数名词 → is；you / we / they / 复数名词 → are。",
      "否定：be 后加 not：I'm not, she isn't, they aren't。",
      "疑问：把 be 提到主语前：Are you a student? — Yes, I am. / No, I'm not.",
      "be 后面可以接：名词（I am a nurse）、形容词（She is busy）、地点（They are at home）。",
      "常见错误：I am agree.（agree 是动词，不用 be）→ I agree."
     ],
     "examples": [
      [
       "Is your sister at home? — No, she isn't.",
       "你姐姐在家吗？——不在。"
      ]
     ]
    }
   ],
