   "grammar": [
    {
     "ref": "b_five"
    },
    {
     "title": "所有句子都是这五种的变形",
     "points": [
      "① 主 + 谓：He sleeps.",
      "② 主 + 系 + 表：She is a doctor. / The food smells good.（系动词：be, look, feel, sound, become, seem, get）",
      "③ 主 + 谓 + 宾：I love music.",
      "④ 主 + 谓 + 间宾 + 直宾：He gave me a book.（= He gave a book to me.）",
      "⑤ 主 + 谓 + 宾 + 宾补：They made him happy. / We call him Tom.",
      "系动词后面接形容词，不接副词：It sounds good.（不是 well）"
     ],
     "examples": [
      [
       "The soup tastes great.",
       "汤很好喝。"
      ],
      [
       "My mother bought me a new bag.",
       "妈妈给我买了个新包。"
      ]
     ]
    }
   ],
