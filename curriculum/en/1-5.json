   "grammar": [
    {
     "title": "There is / There are",
     "points": [
      "表示“某处有某物”：There is a park near my house. There are two banks on this street.",
      "be 和后面<b>最近的名词</b>一致：There is a pen and two books. / There are two books and a pen.",
      "否定：There isn't any milk. / There aren't any chairs.　疑问：Is there a station near here?",
      "不要和 have 混用：“桌上有一本书”→ There is a book on the table.（不说 The table has a book）",
      "过去：There was / There were；将来：There will be。"
     ],
     "examples": [
      [
       "Is there a convenience store near here?",
       "这附近有便利店吗？"
      ]
     ]
    }
   ],
