   ],
   "grammar": [
    {
     "title": "借助助动词 do / does",
     "points": [
      "一般现在时的否定：主语 + don't / doesn't + 动词原形：I don't eat meat. She doesn't like coffee.",
      "一般疑问句：Do / Does + 主语 + 动词原形？Does he work here? — Yes, he does. / No, he doesn't.",
      "用了 does / doesn't，后面的动词就回到原形：She doesn't likes ✗ → She doesn't like ✓",
      "be 动词的句子不用 do：Are you tired?（不是 Do you tired?）"
     ],
     "examples": [
      [
       "Does your sister live in Osaka? — No, she doesn't.",
       "你妹妹住在大阪吗？——不是。"
      ]
     ]
    }
   ],
