   "grammar": [
    {
     "ref": "b_future"
    },
    {
     "title": "说将来的两种方式",
     "points": [
      "will + 动词原形：临时决定、预测、承诺：I'll call you later. It will rain tomorrow.",
      "be going to + 动词原形：已有的打算；有迹象的预测：I'm going to visit Paris next month. Look at the clouds — it's going to rain.",
      "现在进行时也能表示已安排好的将来：I'm meeting Tom tomorrow.",
      "时间和条件状语从句里用一般现在时表将来：I'll call you when I get home.（不说 when I will get）"
     ],
     "examples": [
      [
       "I'm going to start a new job next week.",
       "我下周要开始一份新工作。"
      ]
     ]
    }
   ],
   "special": [
