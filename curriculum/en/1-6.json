   "grammar": [
    {
     "ref": "b_perfect"
    },
    {
     "title": "过去的事和现在有关",
     "points": [
      "结构：have / has + 过去分词：I have finished. She has gone.",
      "常用过去分词：been, done, gone, seen, eaten, written, taken, given, made, had, finished, lived",
      "经历：Have you ever been to Japan? I have never seen snow.",
      "持续到现在：I have lived here for ten years / since 2015.",
      "和一般过去时的区别：有明确过去时间（yesterday, last year, ago）只能用一般过去时。",
      "have been to（去过，回来了） vs have gone to（去了，还没回来）。"
     ],
     "examples": [
      [
       "I have never been to Europe.",
       "我从来没去过欧洲。"
      ]
     ]
    }
   ],
