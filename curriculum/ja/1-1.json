  {
   "id": "ja.1.1.2",
   "title": "政治と行政",
   "words": [
    "立案",
    "参画",
    "提起",
    "明言",
    "言明",
    "善処",
    "却下",
    "順延",
    "一元化",
    "打診",
    "遂行",
    "断行",
    "推奨",
    "喚起",
    "啓発"
   ],
   "grammar": [
    {
     "ref": "〜に鑑みて"
    },
    {
     "ref": "〜を踏まえて"
    },
    {
     "title": "官方用语的分寸",
     "points": [
      "「善処します」字面是“妥善处理”，政治场合常是不作承诺的推脱。",
      "「明言」：明确表态；「明言を避ける」：回避表态。「言明」更书面。",
      "「打診」：试探对方意向（就任、合作）；「参画」：从规划阶段参与。",
      "「〜に鑑みて」：鉴于（重大情况）；「〜を踏まえて」：以……为前提/基础，更常用。"
     ],
     "examples": [
      [
       "首相は増税について明言を避けた。",
       "首相回避了对增税的明确表态。"
      ]
     ]
    }
   ],
   "special": [
    "物議を醸す",
    "首を突っ込む",
    "槍玉に挙げる",
    "一翼を担う"
   ],
   "exercises": [
    {
